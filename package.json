{
  "name": "orbit",
  "productName": "Orbit",
  "version": "0.3.24",
  "description": "도메인 모델, 기능 명세, 설계, 테스트, 할 일을 한곳에서 관리하는 데스크톱 앱",
  "main": "./out/main/index.js",
  "author": "mohitto55",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/fix-node-pty.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:junit": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "cytoscape": "^3.30.2",
    "cytoscape-edgehandles": "^4.0.1",
    "diff": "^5.2.0",
    "electron-updater": "^6.3.4",
    "fast-xml-parser": "^4.4.1",
    "gray-matter": "^4.0.3",
    "node-pty": "^1.1.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.5",
    "@types/cytoscape-edgehandles": "^4.0.5",
    "@types/diff": "^5.2.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "com.orbit.app",
    "productName": "Orbit",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mohitto55",
        "repo": "Orbit",
        "releaseType": "draft"
      }
    ]
  }
}
